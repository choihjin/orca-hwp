+fn is_section_root(e: &quick_xml::events::BytesStart<'_>) -> bool {
+    let name = e.name();
+    let (prefix, local) = name
+        .as_ref()
+        .rsplit_once(':')
+        .map_or((None, name.as_ref()), |(p, n)| (Some(p), n));
+    if local != "sec" {
+        return false;
+    }
+    let attr = prefix.map_or_else(|| "xmlns".to_owned(), |p| format!("xmlns:{p}"));
+    let ns = e.attributes().flatten().find(|a| a.key.as_ref() == attr);
+    ns.map_or(prefix.is_none(), |a| {
+        utils::attr_str(&a) == "http://www.hancom.co.kr/hwpml/2011/section"
+    })
+}
