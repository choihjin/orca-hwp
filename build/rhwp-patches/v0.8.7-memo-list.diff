+use crate::document_core::DocumentCore;
+use crate::model::{
+    control::{Control, Field, Parameter},
+    paragraph::{MemoFieldMark, Paragraph},
+    shape::ShapeObject,
+};
+use crate::parser::body_text::{memo_number, MEMO_MAX_DEPTH};
+use serde::Serialize;
+use serde_json::{json, Value};
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CellPath {
+    control_index: usize,
+    cell_index: usize,
+    cell_para_index: usize,
+}
+
+struct Reader {
+    output: Output,
+    found: usize,
+    section: usize,
+    owner: Option<usize>,
+    path: Vec<CellPath>,
+    paragraph_serial: usize,
+    master_seen: Option<std::collections::HashSet<(usize, usize, u32, u32)>>,
+    master_start: usize,
+}
+
+const MAX_JSON_BYTES: usize = 8 * 1024 * 1024;
+const EXCERPT_CHARS: usize = 2000;
+
+#[derive(Serialize, Default)]
+#[serde(rename_all = "camelCase")]
+struct Entry<'a> {
+    number: u32,
+    place: &'a str,
+    author: &'a str,
+    text: Option<&'a str>,
+    date: Option<String>,
+    date_text: Option<&'a str>,
+    paragraph_text: &'a str,
+    anchor_text: &'a str,
+    anchor_key: String,
+    multi_paragraph: bool,
+    ambiguous: bool,
+    text_truncated: bool,
+    section_index: Option<usize>,
+    owner_para_index: Option<usize>,
+    para_index: Option<usize>,
+    path: Option<&'a [CellPath]>,
+    inline_before: Option<usize>,
+    start_char_idx: Option<usize>,
+    end_char_idx: Option<usize>,
+}
+
+struct Output {
+    entries: Vec<u8>,
+    problems: Problems,
+    limit: usize,
+}
+
+// Keep the first affected item in document order. Diagnostic storage does not
+// grow with the number of fields, sections or damaged records.
+#[derive(Default)]
+struct Occurrences {
+    count: usize,
+    first: usize,
+}
+impl Occurrences {
+    fn record(&mut self, index: usize) {
+        if self.count == 0 {
+            self.first = index;
+        }
+        self.count += 1;
+    }
+}
+#[derive(Default)]
+struct Problems {
+    bad_records: usize,
+    missing: usize,
+    no_body: Occurrences,
+    unlinked: Occurrences,
+    unreadable: Occurrences,
+}
+impl Problems {
+    fn entries(&self) -> Vec<Value> {
+        let mut items = Vec::with_capacity(5);
+        if self.bad_records != 0 {
+            items.push(json!({"code":"bad-record","count":self.bad_records}));
+        }
+        if self.missing != 0 {
+            items.push(json!({"code":"missing-memo","count":self.missing}));
+        }
+        if self.no_body.count != 0 {
+            items.push(
+                json!({"code":"no-body","count":self.no_body.count,"number":self.no_body.first}),
+            );
+        }
+        if self.unlinked.count != 0 {
+            items.push(json!({"code":"unlinked-body","count":self.unlinked.count,"number":self.unlinked.first}));
+        }
+        if self.unreadable.count != 0 {
+            items.push(json!({"code":"section-unreadable","count":self.unreadable.count,"sectionIndex":self.unreadable.first}));
+        }
+        items
+    }
+}
+
+// Serialize directly into the response buffers. Checking each write also bounds
+// strings that expand under JSON escaping without allocating an oversized entry.
+struct Limited<'a> {
+    bytes: &'a mut Vec<u8>,
+    room: usize,
+}
+impl std::io::Write for Limited<'_> {
+    fn write(&mut self, b: &[u8]) -> std::io::Result<usize> {
+        if b.len() > self.room {
+            return Err(std::io::ErrorKind::WriteZero.into());
+        }
+        self.bytes.extend_from_slice(b);
+        self.room -= b.len();
+        Ok(b.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+fn append_member(buffer: &mut Vec<u8>, room: usize, value: &impl Serialize) -> bool {
+    use std::io::Write;
+    let before = buffer.len();
+    let mut writer = Limited {
+        bytes: buffer,
+        room,
+    };
+    if (before == 0 || writer.write_all(b",").is_ok())
+        && serde_json::to_writer(&mut writer, value).is_ok()
+    {
+        return true;
+    }
+    buffer.truncate(before);
+    false
+}
+impl Output {
+    fn room(&self) -> usize {
+        self.limit.saturating_sub(self.entries.len() + 2) // include the memos array brackets
+    }
+    fn skip(&mut self) {
+        self.problems.missing += 1;
+    }
+    fn entry(&mut self, e: &Entry<'_>) {
+        let room = self.room();
+        if !append_member(&mut self.entries, room, e) {
+            self.skip();
+        }
+    }
+    fn finish(self) -> String {
+        let mut result = Vec::with_capacity(self.entries.len() + 512);
+        result.extend_from_slice(b"{\"memos\":[");
+        result.extend_from_slice(&self.entries);
+        result.extend_from_slice(b"],\"problems\":");
+        serde_json::to_writer(&mut result, &self.problems.entries())
+            .expect("writing to a Vec is infallible");
+        result.push(b'}');
+        String::from_utf8(result).expect("serialized JSON is UTF-8")
+    }
+}
+
+struct BodyText<'a> {
+    value: Option<std::borrow::Cow<'a, str>>,
+    truncated: bool,
+}
+
+struct BodyWriter {
+    value: String,
+    room: usize,
+    truncated: bool,
+    pending_break: bool,
+}
+impl BodyWriter {
+    fn push(&mut self, s: &str) -> Result<(), ()> {
+        if s.is_empty() {
+            return Ok(());
+        }
+        let required = s.len().saturating_add(usize::from(self.pending_break));
+        if required > self.room.saturating_sub(self.value.len()) {
+            return Err(());
+        }
+        if self.pending_break {
+            self.value.push('\n');
+            self.pending_break = false;
+        }
+        self.value.push_str(s);
+        Ok(())
+    }
+    fn block(&mut self, ps: &[Paragraph], depth: usize) -> Result<(), ()> {
+        if ps.is_empty() {
+            return Ok(());
+        }
+        if depth > MEMO_MAX_DEPTH {
+            self.truncated = true;
+            return Ok(());
+        }
+        self.pending_break = !self.value.is_empty() && !self.value.ends_with('\n');
+        for (i, p) in ps.iter().enumerate() {
+            if i > 0 {
+                self.pending_break = false;
+                self.push("\n")?;
+            }
+            self.paragraph(p, depth)?;
+        }
+        self.pending_break = !self.value.is_empty() && !self.value.ends_with('\n');
+        Ok(())
+    }
+    fn paragraph(&mut self, p: &Paragraph, depth: usize) -> Result<(), ()> {
+        self.truncated |= p.memo_body_incomplete;
+        if p.controls.is_empty() {
+            return self.push(&p.text);
+        }
+        let positions = p.control_text_positions();
+        let mut chars = p.text.chars();
+        let mut start = 0;
+        let mut char_pos = 0;
+        for (c, position) in p.controls.iter().zip(positions) {
+            let mut end = start;
+            for ch in chars.by_ref().take(position.saturating_sub(char_pos)) {
+                end += ch.len_utf8();
+                char_pos += 1;
+            }
+            self.push(&p.text[start..end])?;
+            start = end;
+            match c {
+                Control::Table(t) => {
+                    self.caption(t.caption.as_ref(), true, depth + 1)?;
+                    for cell in &t.cells {
+                        self.block(&cell.paragraphs, depth + 1)?;
+                    }
+                    self.caption(t.caption.as_ref(), false, depth + 1)?;
+                }
+                Control::Shape(s) => self.shape(s, depth + 1)?,
+                Control::Picture(pic) => {
+                    if let Some(c) = &pic.caption {
+                        self.block(&c.paragraphs, depth + 1)?;
+                    }
+                }
+                Control::Footnote(n) => self.block(&n.paragraphs, depth + 1)?,
+                Control::Endnote(n) => self.block(&n.paragraphs, depth + 1)?,
+                Control::Header(h) => self.block(&h.paragraphs, depth + 1)?,
+                Control::Footer(h) => self.block(&h.paragraphs, depth + 1)?,
+                Control::Equation(e) => {
+                    let cap = match &e.memo_caption {
+                        Some(Ok(c)) => Some(c.as_ref()),
+                        Some(Err(())) => {
+                            self.truncated = true;
+                            None
+                        }
+                        None => None,
+                    };
+                    self.caption(cap, true, depth + 1)?;
+                    self.push(&e.script)?;
+                    self.caption(cap, false, depth + 1)?;
+                }
+                Control::Form(form) => {
+                    self.push(&form.caption)?;
+                    self.push(&form.text)?;
+                }
+                Control::HiddenComment(_) => {}
+                Control::CharOverlap(c) => {
+                    for ch in &c.chars {
+                        self.push(ch.encode_utf8(&mut [0; 4]))?;
+                    }
+                }
+                Control::Ruby(r) => {
+                    self.push(&r.main_text)?;
+                    self.push(&r.ruby_text)?;
+                }
+                Control::Unknown(_) => self.truncated = true,
+                _ => {}
+            }
+        }
+        self.push(&p.text[start..])
+    }
+    fn caption(
+        &mut self,
+        c: Option<&crate::model::shape::Caption>,
+        before: bool,
+        depth: usize,
+    ) -> Result<(), ()> {
+        use crate::model::shape::CaptionDirection::{Left, Top};
+        if let Some(c) = c {
+            if matches!(c.direction, Left | Top) == before {
+                self.block(&c.paragraphs, depth)?;
+            }
+        }
+        Ok(())
+    }
+    fn shape(&mut self, s: &ShapeObject, depth: usize) -> Result<(), ()> {
+        if depth > MEMO_MAX_DEPTH {
+            self.truncated = true;
+            return Ok(());
+        }
+        let caption = crate::document_core::helpers::get_caption_from_shape(s);
+        self.caption(caption, true, depth)?;
+        if let Some(tb) = s.drawing().and_then(|d| d.text_box.as_ref()) {
+            self.block(&tb.paragraphs, depth)?;
+        }
+        if let ShapeObject::Group(g) = s {
+            for child in &g.children {
+                self.shape(child, depth + 1)?;
+            }
+        }
+        self.caption(caption, false, depth)
+    }
+}
+fn body_text(ps: &[Paragraph], room: usize) -> Result<BodyText<'_>, ()> {
+    use std::borrow::Cow;
+    if ps.is_empty() {
+        return Ok(BodyText {
+            value: None,
+            truncated: false,
+        });
+    }
+    if let [p] = ps {
+        if p.controls.is_empty() {
+            if p.text.len() > room {
+                return Err(());
+            }
+            return Ok(BodyText {
+                value: Some(Cow::Borrowed(&p.text)),
+                truncated: p.memo_body_incomplete,
+            });
+        }
+    }
+    let mut out = BodyWriter {
+        value: String::new(),
+        room,
+        truncated: false,
+        pending_break: false,
+    };
+    out.block(ps, 0)?;
+    Ok(BodyText {
+        value: Some(Cow::Owned(out.value)),
+        truncated: out.truncated,
+    })
+}
+
+#[derive(Clone, Copy)]
+struct MemoRange {
+    control_idx: usize,
+    start: usize,
+    end: Option<usize>,
+    inner_slot_count: usize,
+    ambiguous: bool,
+}
+
+struct OpenField {
+    start_boundary: (usize, usize), // text position and number of preceding non-field controls
+    id: u32,
+    previous_same_id: Option<usize>,
+    paragraph: usize,
+    memo: Option<usize>,
+}
+
+// A body can continue in the next paragraph or section. Each cell, caption,
+// note and text box owns a separate field stack. Index by ID for crossing ranges
+// and retain the opening order for ends with an absent or unmatched reference.
+#[derive(Default)]
+struct FieldScope {
+    open: Vec<Option<OpenField>>,
+    last: std::collections::HashMap<u32, usize>,
+}
+impl FieldScope {
+    fn collect<'a>(
+        paragraphs: impl Iterator<Item = &'a Paragraph>,
+    ) -> std::collections::HashMap<usize, Vec<MemoRange>> {
+        let mut scope = Self::default();
+        let mut all = std::collections::HashMap::<usize, Vec<MemoRange>>::new();
+        let mut active_fields = 0usize;
+        let mut unflagged = std::collections::HashSet::new();
+        for (serial, p) in paragraphs.enumerate() {
+            let mut field_begins = 0;
+            let mut end_run_until = 0;
+            let mut common_end = false;
+            for (mark_idx, &mark) in p.memo_field_marks.iter().enumerate() {
+                match mark {
+                    MemoFieldMark::Binary => {}
+                    MemoFieldMark::Begin { control_idx, pos } => {
+                        let Some(Control::Field(f)) = p.controls.get(control_idx) else {
+                            continue;
+                        };
+                        active_fields += 1;
+                        let memo = memo_number(f).map(|_| {
+                            let ranges = all.entry(serial).or_default();
+                            unflagged.insert((serial, ranges.len()));
+                            ranges.push(MemoRange {
+                                ambiguous: false,
+                                control_idx,
+                                start: pos,
+                                end: None,
+                                inner_slot_count: 0,
+                            });
+                            ranges.len() - 1
+                        });
+                        let previous_same_id = if f.field_id == 0 {
+                            None
+                        } else {
+                            scope.last.insert(f.field_id, scope.open.len())
+                        };
+                        let start_boundary = (pos, control_idx.saturating_sub(field_begins));
+                        field_begins += 1;
+                        scope.open.push(Some(OpenField {
+                            start_boundary,
+                            id: f.field_id,
+                            previous_same_id,
+                            paragraph: serial,
+                            memo,
+                        }));
+                    }
+                    MemoFieldMark::End {
+                        begin_id,
+                        control_count,
+                        pos,
+                    } => {
+                        // Co-located starts and a run closing every live field at one
+                        // character/object boundary give identical ranges in either format.
+                        if mark_idx >= end_run_until {
+                            let same=p.memo_field_marks[mark_idx..].iter().take_while(|m|
+                                matches!(m,MemoFieldMark::End{control_count:c,pos:x,..} if *c==control_count && *x==pos)).count();
+                            end_run_until = mark_idx + same;
+                            common_end = same >= active_fields && active_fields > 1 && {
+                                let mut starts = scope
+                                    .open
+                                    .iter()
+                                    .flatten()
+                                    .map(|f| (f.paragraph, f.start_boundary));
+                                let first = starts.next();
+                                starts.all(|s| Some(s) == first)
+                            };
+                        }
+                        let matched = scope.last.get(&begin_id).copied();
+                        if matched.is_none() && active_fields > 1 && !common_end {
+                            for (para, index) in unflagged.drain() {
+                                all.get_mut(&para).unwrap()[index].ambiguous = true;
+                            }
+                        }
+                        let Some(top) = scope.open.len().checked_sub(1) else {
+                            continue;
+                        };
+                        let slot = matched.unwrap_or(top);
+                        active_fields -= 1;
+                        let field = scope.open[slot].take().expect("index of an open field");
+                        if let Some(older) = field.previous_same_id {
+                            scope.last.insert(field.id, older);
+                        } else {
+                            scope.last.remove(&field.id);
+                        }
+                        while scope.open.last().is_some_and(Option::is_none) {
+                            scope.open.pop();
+                        }
+                        if let Some(i) = field.memo {
+                            unflagged.remove(&(field.paragraph, i));
+                            if field.paragraph == serial {
+                                let r = &mut all.get_mut(&serial).unwrap()[i];
+                                r.end = Some(pos);
+                                r.inner_slot_count =
+                                    control_count.saturating_sub(r.control_idx + 1);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        all
+    }
+}
+
+struct Anchors {
+    chars: Vec<char>,
+    excerpt: String,
+    ranges: Vec<Option<MemoRange>>,
+    inline_before: Option<Vec<usize>>,
+    ambiguous: Vec<bool>,
+    positions: Option<Vec<usize>>,
+}
+impl Anchors {
+    fn new(p: &Paragraph, place: &str, memo_ranges: &[MemoRange]) -> Self {
+        let chars: Vec<_> = p.text.chars().collect();
+        let excerpt = chars.iter().take(EXCERPT_CHARS).collect();
+        let mut ranges = vec![None; p.controls.len()];
+        if p.memo_field_marks.is_empty()
+            || matches!(p.memo_field_marks.first(), Some(MemoFieldMark::Binary))
+        {
+            for r in &p.field_ranges {
+                if let Some(slot) = ranges.get_mut(r.control_idx) {
+                    slot.get_or_insert(MemoRange {
+                        ambiguous: false,
+                        start: r.start_char_idx,
+                        end: Some(r.end_char_idx),
+                        control_idx: r.control_idx,
+                        inner_slot_count: r.inner_slot_count,
+                    });
+                }
+            }
+        } else {
+            for r in memo_ranges {
+                if let Some(slot) = ranges.get_mut(r.control_idx) {
+                    *slot = Some(*r);
+                }
+            }
+        }
+        Self {
+            chars,
+            excerpt,
+            ranges,
+            ambiguous: {
+                let mut flags = vec![false; p.controls.len()];
+                for r in memo_ranges {
+                    flags[r.control_idx] = r.ambiguous;
+                }
+                flags
+            },
+            inline_before: memo_inline_prefix(p, place),
+            positions: None,
+        }
+    }
+}
+
+// The paragraph renderer advances its sub-run index for entries in the composer's
+// tac_controls, including forms. Note markers are separate render nodes. The
+// dedicated body-table path and multiple text runs need not share a single shift.
+fn memo_inline_prefix(p: &Paragraph, place: &str) -> Option<Vec<usize>> {
+    if p.controls
+        .iter()
+        .any(|c| matches!(c, Control::CharOverlap(_) | Control::Unknown(_)))
+    {
+        return None;
+    }
+    let is_tac = |c: &Control| {
+        c.is_treat_as_char_object() || matches!(c,Control::Form(f) if f.common.treat_as_char)
+    };
+    if !p.controls.iter().any(is_tac) {
+        return Some(Vec::new());
+    }
+    if p.text.contains('\u{fffc}') {
+        return None;
+    }
+    let composed = crate::renderer::composer::compose_paragraph(p);
+    let mut emitted = vec![false; p.controls.len()];
+    for &(_, _, ci) in &composed.tac_controls {
+        emitted[ci] = true;
+    }
+    // Body tables without other inline shapes use layout_inline_table_paragraph:
+    // its text runs keep the source character axis. For a block table the page
+    // fragment can select a different path. Cells use the general paragraph renderer.
+    if place == "body"
+        && p.controls
+            .iter()
+            .any(|c| matches!(c,Control::Table(t) if t.common.treat_as_char))
+        && !p.controls.iter().any(|c| {
+            matches!(c, Control::Equation(_))
+                || matches!(c, Control::Shape(_) | Control::Picture(_)) && is_tac(c)
+        })
+    {
+        let dedicated_table_path = p
+            .controls
+            .iter()
+            .enumerate()
+            .all(|(ci, c)| !is_tac(c) || (matches!(c, Control::Table(_)) && emitted[ci]));
+        return dedicated_table_path.then(Vec::new);
+    }
+    let text_line = match composed.lines.as_slice() {
+        [line] => line,
+        [table_line, line]
+            if place == "tableCell"
+                && table_line.runs.is_empty()
+                && table_line.has_line_break
+                && table_line.char_start == line.char_start =>
+        {
+            // compose_paragraph inserts a synthetic empty line for a block-width TAC table.
+            // Cell layout advances char_offset by one for its break before painting the text.
+            let mut tables = p.controls.iter().enumerate().filter(|(ci, c)| {
+                !emitted[*ci] && matches!(c,Control::Table(t) if t.common.treat_as_char)
+            });
+            let (ci, _) = tables.next()?;
+            if tables.next().is_some()
+                || p.controls[..ci]
+                    .iter()
+                    .any(|c| matches!(c,Control::Field(f) if memo_number(f).is_some()))
+            {
+                return None;
+            }
+            emitted[ci] = true;
+            line
+        }
+        _ => return None,
+    };
+    if text_line.runs.iter().filter(|r| !r.text.is_empty()).count() != 1 {
+        return None;
+    }
+    let mut prefix = Vec::with_capacity(emitted.len());
+    let mut count = 0;
+    for (ci, ctrl) in p.controls.iter().enumerate() {
+        if is_tac(ctrl) != emitted[ci] {
+            return None;
+        }
+        prefix.push(count);
+        count += usize::from(emitted[ci]);
+    }
+    Some(prefix)
+}
+
+// The innermost cell or text box can be located only under an addressable owner.
+fn nested_place(outer: &'static str, inner: &'static str) -> &'static str {
+    match outer {
+        "body" | "tableCell" | "textBox" => inner,
+        _ => outer,
+    }
+}
+fn persistent_place(outer: &'static str, inner: &'static str) -> &'static str {
+    match outer {
+        "header" | "footer" | "masterPage" => outer,
+        _ => inner,
+    }
+}
+fn param<'a>(field: &'a Field, key: &str) -> Option<&'a str> {
+    field.parameters.items.iter().find_map(|p| match p {
+        Parameter::String {
+            name: Some(name),
+            value,
+            ..
+        } if name == key => Some(value.as_str()),
+        _ => None,
+    })
+}
+
+fn command_date(command: &str) -> Option<String> {
+    let mut tokens = command.strip_prefix("MEMO/")?.split('/').skip(2);
+    let low = tokens.next()?.parse::<u32>().ok()?;
+    let high = tokens.next()?.parse::<u32>().ok()?;
+    let ticks = u64::from(high) << 32 | u64::from(low);
+    if ticks == 0 {
+        return None;
+    }
+    filetime_to_iso(ticks)
+}
+
+impl Reader {
+    fn nested(
+        &mut self,
+        paragraphs: &[Paragraph],
+        place: &'static str,
+        depth: usize,
+        cell: Option<(usize, usize)>,
+        markable: bool,
+    ) {
+        if paragraphs.is_empty() || depth > MEMO_MAX_DEPTH {
+            return;
+        }
+        let fields = FieldScope::collect(paragraphs.iter());
+        for (pi, p) in paragraphs.iter().enumerate() {
+            if let Some((control_index, cell_index)) = cell {
+                self.path.push(CellPath {
+                    control_index,
+                    cell_index,
+                    cell_para_index: pi,
+                });
+            }
+            self.paragraph(
+                p,
+                pi,
+                place,
+                depth,
+                markable,
+                fields.get(&pi).map(Vec::as_slice).unwrap_or_default(),
+            );
+            if cell.is_some() {
+                self.path.pop();
+            }
+        }
+    }
+    fn shape(
+        &mut self,
+        s: &ShapeObject,
+        ci: usize,
+        place: &'static str,
+        depth: usize,
+        markable: bool,
+    ) {
+        if depth > MEMO_MAX_DEPTH {
+            return;
+        }
+        if let Some(tb) = s.drawing().and_then(|d| d.text_box.as_ref()) {
+            self.nested(
+                &tb.paragraphs,
+                nested_place(place, "textBox"),
+                depth + 1,
+                Some((ci, 0)),
+                markable,
+            );
+        }
+        if let Some(c) = crate::document_core::helpers::get_caption_from_shape(s) {
+            self.nested(
+                &c.paragraphs,
+                persistent_place(place, "caption"),
+                depth + 1,
+                None,
+                false,
+            );
+        }
+        if let ShapeObject::Group(g) = s {
+            // Cell paths have no group-child component.
+            for child in &g.children {
+                self.shape(child, ci, place, depth + 1, false);
+            }
+        }
+    }
+    fn paragraph(
+        &mut self,
+        p: &Paragraph,
+        pi: usize,
+        place: &'static str,
+        depth: usize,
+        markable: bool,
+        memo_ranges: &[MemoRange],
+    ) {
+        self.paragraph_serial += 1;
+        let serial = self.paragraph_serial;
+
+        let mut anchors = None;
+        for (ci, ctrl) in p.controls.iter().enumerate() {
+            match ctrl {
+                Control::Field(f) => {
+                    let Some(number) = memo_number(f) else {
+                        continue;
+                    };
+                    self.found += 1;
+                    if let Some(seen) = &mut self.master_seen {
+                        if !seen.insert((serial - self.master_start, ci, number, f.field_id)) {
+                            continue;
+                        }
+                    }
+                    if f.memo_paragraphs.is_empty() {
+                        self.output.problems.no_body.record(number as usize);
+                    }
+                    let Ok(body) = body_text(&f.memo_paragraphs, self.output.room()) else {
+                        self.output.skip();
+                        continue;
+                    };
+                    let a = anchors.get_or_insert_with(|| Anchors::new(p, place, memo_ranges));
+                    let range = a.ranges[ci];
+                    let start = range.map(|r| r.start).unwrap_or_else(|| {
+                        a.positions
+                            .get_or_insert_with(|| p.control_text_positions())
+                            .get(ci)
+                            .copied()
+                            .unwrap_or_default()
+                    });
+                    let end = range.and_then(|r| r.end);
+                    let key = match range {
+                        Some(r) if end == Some(start) => format!(
+                            "{serial}/{start}/{start}/{}",
+                            ci.saturating_add(r.inner_slot_count)
+                        ),
+                        Some(MemoRange { end: Some(end), .. }) => format!("{serial}/{start}/{end}"),
+                        _ => format!("{serial}/open/{ci}"),
+                    };
+                    let from = start.min(a.chars.len());
+                    let to = end
+                        .unwrap_or(a.chars.len())
+                        .clamp(from, a.chars.len())
+                        .min(from.saturating_add(EXCERPT_CHARS));
+                    let anchor: String = a.chars[from..to].iter().collect();
+                    let date = command_date(&f.command);
+                    let date_text = if date.is_none() {
+                        param(f, "CreateDateTime")
+                    } else {
+                        None
+                    };
+                    let author =
+                        param(f, "Author")
+                            .filter(|a| !a.is_empty())
+                            .unwrap_or_else(|| {
+                                let tail = f.command.splitn(6, '/').nth(5).unwrap_or("");
+                                tail.rsplit_once('/').map_or(tail, |(author, _)| author)
+                            });
+                    let entry = Entry {
+                        number,
+                        place,
+                        text: body.value.as_deref(),
+                        author,
+                        date,
+                        date_text,
+                        anchor_text: &anchor,
+                        paragraph_text: &a.excerpt,
+                        anchor_key: key,
+                        multi_paragraph: end.is_none(),
+                        ambiguous: a.ambiguous[ci],
+                        text_truncated: body.truncated,
+                        section_index: Some(self.section),
+                        owner_para_index: self.owner,
+                        para_index: markable.then_some(pi),
+                        path: markable.then_some(&self.path),
+                        inline_before: a
+                            .inline_before
+                            .as_ref()
+                            .map(|counts| counts.get(ci).copied().unwrap_or(0)),
+                        start_char_idx: markable.then_some(start),
+                        end_char_idx: end.filter(|_| markable),
+                    };
+                    self.output.entry(&entry);
+                }
+                Control::Table(t) => {
+                    for (i, c) in t.cells.iter().enumerate() {
+                        self.nested(
+                            &c.paragraphs,
+                            nested_place(place, "tableCell"),
+                            depth + 1,
+                            Some((ci, i)),
+                            markable,
+                        );
+                    }
+                    if let Some(c) = &t.caption {
+                        self.nested(
+                            &c.paragraphs,
+                            persistent_place(place, "caption"),
+                            depth + 1,
+                            None,
+                            false,
+                        );
+                    }
+                }
+                Control::Shape(s) => self.shape(s, ci, place, depth, markable),
+                Control::Picture(pic) => {
+                    if let Some(c) = &pic.caption {
+                        self.nested(
+                            &c.paragraphs,
+                            persistent_place(place, "caption"),
+                            depth + 1,
+                            None,
+                            false,
+                        );
+                    }
+                }
+                Control::Header(h) => self.nested(&h.paragraphs, "header", depth + 1, None, false),
+                Control::Footer(h) => self.nested(&h.paragraphs, "footer", depth + 1, None, false),
+                Control::Footnote(n) => self.nested(
+                    &n.paragraphs,
+                    persistent_place(place, "footnote"),
+                    depth + 1,
+                    None,
+                    false,
+                ),
+                Control::Endnote(n) => self.nested(
+                    &n.paragraphs,
+                    persistent_place(place, "endnote"),
+                    depth + 1,
+                    None,
+                    false,
+                ),
+                _ => {}
+            }
+        }
+    }
+}
+
+impl DocumentCore {
+    pub fn get_memos_json(&self) -> String {
+        self.memos_json_with_limit(MAX_JSON_BYTES)
+    }
+    fn memos_json_with_limit(&self, limit: usize) -> String {
+        let mut reader = Reader {
+            output: Output {
+                entries: vec![],
+                problems: Problems::default(),
+                limit,
+            },
+            found: 0,
+            section: 0,
+            owner: None,
+            path: vec![],
+            paragraph_serial: 0,
+            master_seen: None,
+            master_start: 0,
+        };
+        let body_fields = FieldScope::collect(
+            self.document
+                .sections
+                .iter()
+                .flat_map(|s| s.paragraphs.iter()),
+        );
+        let mut body_ordinal = 0;
+        let mut master_fields = std::collections::HashMap::new();
+        for (si, s) in self.document.sections.iter().enumerate() {
+            reader.section = si;
+            reader.output.problems.bad_records += s.memo_problems.bad_records;
+            if s.memo_problems.section_unreadable {
+                reader.output.problems.unreadable.record(si);
+            }
+            reader.found = 0;
+            for (pi, p) in s.paragraphs.iter().enumerate() {
+                reader.owner = Some(pi);
+                reader.paragraph(
+                    p,
+                    pi,
+                    "body",
+                    0,
+                    true,
+                    body_fields
+                        .get(&body_ordinal)
+                        .map(Vec::as_slice)
+                        .unwrap_or_default(),
+                );
+                body_ordinal += 1;
+            }
+            reader.owner = None;
+            let mut declared = s.declared_memo_count;
+            let mut sources = s.memo_master_sources.iter().peekable();
+            for (i, mp) in s.section_def.master_pages.iter().enumerate() {
+                let src = sources.next_if(|src| src.0 == i);
+                let previous = src.and_then(|(_, path, _)| master_fields.remove(path.as_str()));
+                let repeated = previous.is_some();
+                reader.master_seen = src.map(|_| previous.unwrap_or_default());
+                reader.master_start = reader.paragraph_serial;
+                let before = reader.found;
+                reader.nested(&mp.paragraphs, "masterPage", 0, None, false);
+                if let Some((_, path, count)) = src {
+                    master_fields.insert(path.as_str(), reader.master_seen.take().unwrap());
+                    if repeated {
+                        declared = declared.saturating_sub(*count);
+                        reader.found = before;
+                    }
+                }
+            }
+            reader.output.problems.missing += declared.saturating_sub(reader.found);
+        }
+        if let Some((first, count)) = self.document.doc_info.omitted_memo_sections {
+            let unread = &mut reader.output.problems.unreadable;
+            if unread.count == 0 || first < unread.first {
+                unread.first = first;
+            }
+            unread.count += count;
+        }
+        for (si, s) in self.document.sections.iter().enumerate() {
+            for (i, b) in s.memo_bodies.iter().enumerate() {
+                reader.output.problems.unlinked.record(b.number as usize);
+                let Ok(body) = body_text(&b.paragraphs, reader.output.room()) else {
+                    reader.output.skip();
+                    continue;
+                };
+                let entry = Entry {
+                    text_truncated: body.truncated,
+                    place: "unlinked",
+                    number: b.number,
+                    text: body.value.as_deref(),
+                    anchor_key: format!("unlinked/{si}/{i}"),
+                    ..Default::default()
+                };
+                reader.output.entry(&entry);
+            }
+        }
+        reader.output.finish()
+    }
+}
+
+fn filetime_to_iso(ft: u64) -> Option<String> {
+    const SECS_1601_TO_1970: i64 = 11_644_473_600;
+    let secs = (ft / 10_000_000) as i64 - SECS_1601_TO_1970;
+    let days = secs.div_euclid(86_400);
+    let rem = secs.rem_euclid(86_400);
+    // Howard Hinnant, civil_from_days (proleptic Gregorian).
+    let z = days + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let year = y + i64::from(m <= 2);
+    if !(1601..=9999).contains(&year) {
+        return None;
+    }
+    Some(format!(
+        "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z",
+        year,
+        m,
+        d,
+        rem / 3600,
+        (rem % 3600) / 60,
+        rem % 60
+    ))
+}
