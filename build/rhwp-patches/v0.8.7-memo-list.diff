+
+/// Record::read_all rejects the whole stream when a record is truncated. Count the
+/// complete declarations before it so a fallback section can still report the loss.
+pub(super) fn unreadable_section(mut bytes: &[u8]) -> Section {
+    let mut declared_memo_count = 0;
+    while let Some(head) = bytes.first_chunk::<4>() {
+        let word = u32::from_le_bytes(*head);
+        let tag = (word & 0x3ff) as u16;
+        let mut size = word >> 20;
+        bytes = &bytes[4..];
+        if size == 0xfff {
+            let Some(size_bytes) = bytes.first_chunk::<4>() else {
+                break;
+            };
+            size = u32::from_le_bytes(*size_bytes);
+            bytes = &bytes[4..];
+        }
+        let Some((data, rest)) = bytes.split_at_checked(size as usize) else {
+            break;
+        };
+        declared_memo_count += usize::from(is_memo_control(tag, data));
+        bytes = rest;
+    }
+    Section {
+        declared_memo_count,
+        memo_problems: vec![MemoProblem::SectionUnreadable],
+        ..Default::default()
+    }
+}
