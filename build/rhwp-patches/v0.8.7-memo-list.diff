+    /// A diagnostic-only prefix read. The Take is below the XML buffer so
+    /// neither a long prolog nor a long start tag can inflate the whole member.
+    /// Missing entries, read failures and incomplete prefixes supply no evidence.
+    pub(super) fn section_root(&mut self, path: &str) -> Option<bool> {
+        use quick_xml::{events::Event, Reader};
+        const PREFIX_BYTES: u64 = 64 * 1024;
+        let file = self.archive.by_name(path).ok()?;
+        let mut reader = Reader::from_reader(io::BufReader::new(file.take(PREFIX_BYTES)));
+        let mut buf = Vec::new();
+        loop {
+            match reader.read_event_into(&mut buf).ok()? {
+                Event::Start(e) | Event::Empty(e) => {
+                    if e.attributes().any(|attr| attr.is_err()) {
+                        return None;
+                    }
+                    return Some(super::utils::local_name(e.name().as_ref()) == b"sec");
+                }
+                Event::Decl(_) | Event::Comment(_) | Event::PI(_) | Event::DocType(_) => {}
+                Event::Text(t) if t.as_ref().trim().is_empty() => {}
+                _ => return None,
+            }
+            buf.clear();
+        }
+    }
