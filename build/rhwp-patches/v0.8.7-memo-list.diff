+// Observe the XML independently of the subset of controls modelled by the parser.
+// Keep every complete fieldBegin seen before an XML error or a premature EOF.
+fn inspect_memo_xml(xml: &str) -> MemoXml {
+    use quick_xml::{events::Event, Reader};
+    let mut reader = Reader::from_str(xml);
+    let mut scan = MemoXml::default();
+    let mut saw_root = false;
+    let mut extra_root = false;
+    #[derive(Default)]
+    struct FieldDecl {
+        depth: usize,
+        typed: bool,
+        params: Option<usize>,
+        command: Option<usize>,
+        prefix: [u8; 5],
+        len: usize,
+    }
+    impl FieldDecl {
+        fn text(&mut self, t: &str) {
+            if self.command.is_some() {
+                let n = (5 - self.len).min(t.len());
+                self.prefix[self.len..self.len + n].copy_from_slice(&t.as_bytes()[..n]);
+                self.len += n;
+            }
+        }
+        fn command_is_memo(&self) -> bool {
+            !self.typed && self.prefix == *b"MEMO/"
+        }
+    }
+    let mut fields: Vec<FieldDecl> = Vec::new();
+    let mut depth = 0usize;
+    loop {
+        let event = match reader.read_event() {
+            Ok(e) => e,
+            Err(_) => {
+                scan.xml_error = true;
+                break;
+            }
+        };
+        let start = matches!(event, Event::Start(_));
+        match event {
+            Event::Start(e) | Event::Empty(e) => {
+                let name = e.name();
+                let local = utils::local_name(name.as_ref());
+                if depth == 0 {
+                    if saw_root {
+                        extra_root = true;
+                    }
+                    scan.section_root = !saw_root && is_section_root(&e);
+                    saw_root = true;
+                }
+                let level = depth + 1;
+                match local {
+                    b"fieldBegin" => {
+                        let typed = e
+                            .attributes()
+                            .flatten()
+                            .any(|a| a.key.as_ref() == "type" && utils::attr_str(&a) == "MEMO");
+                        if typed {
+                            scan.count += 1;
+                        }
+                        if start {
+                            fields.push(FieldDecl {
+                                depth: level,
+                                typed,
+                                ..Default::default()
+                            });
+                        }
+                    }
+                    b"parameters" => {
+                        if let Some(f) = fields.last_mut().filter(|f| start && level == f.depth + 1)
+                        {
+                            f.params = Some(level);
+                        }
+                    }
+                    b"stringParam" => {
+                        if let Some(f) =
+                            fields.last_mut().filter(|f| !f.typed && f.params.is_some())
+                        {
+                            if e.attributes().flatten().any(|a| {
+                                a.key.as_ref() == "name" && utils::attr_str(&a) == "Command"
+                            }) {
+                                f.prefix = [0; 5];
+                                f.len = 0;
+                                f.command = start.then_some(level);
+                            }
+                        }
+                    }
+                    b"masterPage" => {
+                        if let Some(attr) = e
+                            .attributes()
+                            .flatten()
+                            .find(|a| a.key.as_ref() == "idRef" && !a.value.is_empty())
+                        {
+                            scan.master_refs.push(utils::attr_str(&attr));
+                        } else {
+                            scan.missing_master_ref = true;
+                        }
+                    }
+                    _ => {}
+                }
+                if start {
+                    depth = level;
+                }
+            }
+            Event::Text(t) => {
+                if depth == 0 && !t.as_ref().trim().is_empty() {
+                    extra_root = true;
+                }
+                if let Some(f) = fields.last_mut() {
+                    f.text(t.as_ref());
+                }
+            }
+            Event::CData(t) => {
+                if let Some(f) = fields.last_mut() {
+                    f.text(t.as_ref());
+                }
+            }
+            Event::GeneralRef(r) => {
+                if let Some(f) = fields
+                    .last_mut()
+                    .filter(|f| f.command.is_some() && f.len < 5)
+                {
+                    f.text(&section::decode_xml_general_ref(&r));
+                }
+            }
+            Event::End(_) => {
+                if let Some(f) = fields.last_mut() {
+                    if f.command == Some(depth) {
+                        f.command = None;
+                    }
+                    if f.params == Some(depth) {
+                        f.params = None;
+                    }
+                    if f.depth == depth {
+                        scan.count += usize::from(f.command_is_memo());
+                        fields.pop();
+                    }
+                }
+                depth = depth.saturating_sub(1);
+            }
+            Event::Eof => {
+                scan.complete = saw_root && depth == 0 && !extra_root && !scan.xml_error;
+                break;
+            }
+            _ => {}
+        }
+    }
+    scan.count += fields.iter().filter(|f| f.command_is_memo()).count();
+    scan
+}
