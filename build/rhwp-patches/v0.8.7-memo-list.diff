@@ -0,0 +1,451 @@
+use crate::document_core::DocumentCore;
+use crate::model::{
+    control::{Control, Field, Parameter},
+    document::MemoProblem,
+    paragraph::Paragraph,
+    shape::ShapeObject,
+};
+use crate::parser::body_text::{memo_number, MEMO_MAX_DEPTH};
+use serde::Serialize;
+use serde_json::{json, Value};
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CellPath {
+    control_index: usize,
+    cell_index: usize,
+    cell_para_index: usize,
+}
+
+struct Reader {
+    memos: Vec<Value>,
+    problems: Vec<Value>,
+    section: usize,
+    owner: Option<usize>,
+    path: Vec<CellPath>,
+    paragraph_serial: usize,
+}
+
+fn text(paragraphs: &[Paragraph]) -> Option<String> {
+    (!paragraphs.is_empty()).then(|| {
+        paragraphs
+            .iter()
+            .map(|p| p.text.as_str())
+            .collect::<Vec<_>>()
+            .join("\n")
+    })
+}
+
+fn param<'a>(field: &'a Field, key: &str) -> Option<&'a str> {
+    field.parameters.items.iter().find_map(|p| match p {
+        Parameter::String {
+            name: Some(name),
+            value,
+            ..
+        } if name == key => Some(value.as_str()),
+        _ => None,
+    })
+}
+
+fn command_date(command: &str) -> Option<String> {
+    let mut tokens = command.strip_prefix("MEMO/")?.split('/').skip(2);
+    let low = tokens.next()?.parse::<u32>().ok()?;
+    let high = tokens.next()?.parse::<u32>().ok()?;
+    let ticks = u64::from(high) << 32 | u64::from(low);
+    (ticks != 0).then(|| filetime_to_iso(ticks))
+}
+
+impl Reader {
+    fn within_limit(&mut self, depth: usize) -> bool {
+        if depth <= MEMO_MAX_DEPTH {
+            return true;
+        }
+        self.problems.push(json!({"code":"bad-record"}));
+        false
+    }
+    fn nested(
+        &mut self,
+        paragraphs: &[Paragraph],
+        place: &'static str,
+        depth: usize,
+        cell: Option<(usize, usize)>,
+        markable: bool,
+    ) {
+        if paragraphs.is_empty() || !self.within_limit(depth) {
+            return;
+        }
+        for (pi, p) in paragraphs.iter().enumerate() {
+            if let Some((control_index, cell_index)) = cell {
+                self.path.push(CellPath {
+                    control_index,
+                    cell_index,
+                    cell_para_index: pi,
+                });
+            }
+            self.paragraph(p, pi, place, depth, markable);
+            if cell.is_some() {
+                self.path.pop();
+            }
+        }
+    }
+    fn shape(&mut self, s: &ShapeObject, ci: usize, depth: usize, markable: bool) {
+        if !self.within_limit(depth) {
+            return;
+        }
+        if let Some(tb) = s.drawing().and_then(|d| d.text_box.as_ref()) {
+            self.nested(
+                &tb.paragraphs,
+                "textBox",
+                depth + 1,
+                Some((ci, 0)),
+                markable,
+            );
+        }
+        if let Some(c) = crate::document_core::helpers::get_caption_from_shape(s) {
+            self.nested(&c.paragraphs, "caption", depth + 1, None, false);
+        }
+        if let ShapeObject::Group(g) = s {
+            // Cell paths have no group-child component.
+            for child in &g.children {
+                self.shape(child, ci, depth + 1, false);
+            }
+        }
+    }
+    fn paragraph(
+        &mut self,
+        p: &Paragraph,
+        pi: usize,
+        place: &'static str,
+        depth: usize,
+        markable: bool,
+    ) {
+        self.paragraph_serial += 1;
+        let serial = self.paragraph_serial;
+        let mut positions = None;
+        for (ci, ctrl) in p.controls.iter().enumerate() {
+            match ctrl {
+                Control::Field(f) => {
+                    let Some(number) = memo_number(f) else {
+                        continue;
+                    };
+                    let range = p.field_ranges.iter().find(|r| r.control_idx == ci);
+                    let start = range.map(|r| r.start_char_idx).unwrap_or_else(|| {
+                        positions
+                            .get_or_insert_with(|| p.control_text_positions())
+                            .get(ci)
+                            .copied()
+                            .unwrap_or_default()
+                    });
+                    let end = range.map(|r| r.end_char_idx);
+                    let length = end.map_or(usize::MAX, |e| e.saturating_sub(start));
+                    let anchor: String = p.text.chars().skip(start).take(length).collect();
+                    let key = match end {
+                        Some(end) => format!("{serial}/{start}/{end}"),
+                        None => format!("{serial}/open/{ci}"),
+                    };
+                    let body = text(&f.memo_paragraphs);
+                    if body.is_none() {
+                        self.problems
+                            .push(json!({"code":"no-body","number":number}));
+                    }
+                    let date = command_date(&f.command);
+                    let date_text = if date.is_none() {
+                        param(f, "CreateDateTime")
+                    } else {
+                        None
+                    };
+                    let author = param(f, "Author")
+                        .or_else(|| f.command.split('/').nth(5))
+                        .unwrap_or_default();
+                    self.memos.push(json!({"number":number,"place":place,"text":body,"author":author,"date":date,"dateText":date_text,
+                        "anchorText":anchor,"paragraphText":p.text,"anchorKey":key,"multiParagraph":end.is_none(),"sectionIndex":self.section,"ownerParaIndex":self.owner,
+                        "paraIndex":markable.then_some(pi),"path":markable.then_some(&self.path),"startCharIdx":markable.then_some(start),"endCharIdx":end.filter(|_|markable)}));
+                }
+                Control::Table(t) => {
+                    for (i, c) in t.cells.iter().enumerate() {
+                        self.nested(
+                            &c.paragraphs,
+                            "tableCell",
+                            depth + 1,
+                            Some((ci, i)),
+                            markable,
+                        );
+                    }
+                    if let Some(c) = &t.caption {
+                        self.nested(&c.paragraphs, "caption", depth + 1, None, false);
+                    }
+                }
+                Control::Shape(s) => self.shape(s, ci, depth, markable),
+                Control::Picture(pic) => {
+                    if let Some(c) = &pic.caption {
+                        self.nested(&c.paragraphs, "caption", depth + 1, None, false);
+                    }
+                }
+                Control::Header(h) => self.nested(&h.paragraphs, "header", depth + 1, None, false),
+                Control::Footer(h) => self.nested(&h.paragraphs, "footer", depth + 1, None, false),
+                Control::Footnote(n) => {
+                    self.nested(&n.paragraphs, "footnote", depth + 1, None, false)
+                }
+                Control::Endnote(n) => {
+                    self.nested(&n.paragraphs, "endnote", depth + 1, None, false)
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+impl DocumentCore {
+    pub fn get_memos_json(&self) -> String {
+        let mut reader = Reader {
+            memos: vec![],
+            problems: vec![],
+            section: 0,
+            owner: None,
+            path: vec![],
+            paragraph_serial: 0,
+        };
+        for (si, s) in self.document.sections.iter().enumerate() {
+            reader.section = si;
+            for problem in &s.memo_problems {
+                reader.problems.push(match problem {
+                    MemoProblem::BadRecord => json!({"code":"bad-record"}),
+                    MemoProblem::SectionUnreadable => {
+                        json!({"code":"section-unreadable","sectionIndex":si})
+                    }
+                });
+            }
+            for (pi, p) in s.paragraphs.iter().enumerate() {
+                reader.owner = Some(pi);
+                reader.paragraph(p, pi, "body", 0, true);
+            }
+            reader.owner = None;
+            for mp in &s.section_def.master_pages {
+                reader.nested(&mp.paragraphs, "masterPage", 0, None, false);
+            }
+        }
+        for (si, s) in self.document.sections.iter().enumerate() {
+            for (i, b) in s.memo_bodies.iter().enumerate() {
+                reader.memos.push(json!({"place":"unlinked","number":b.number,"author":"","date":null,"dateText":null,"text":text(&b.paragraphs),
+                    "anchorText":"","paragraphText":"","multiParagraph":false,"anchorKey":format!("unlinked/{si}/{i}"),
+                    "sectionIndex":null,"ownerParaIndex":null,"paraIndex":null,"path":null,"startCharIdx":null,"endCharIdx":null}));
+                reader
+                    .problems
+                    .push(json!({"code":"unlinked-body","number":b.number}));
+            }
+        }
+        json!({"memos":reader.memos,"problems":reader.problems}).to_string()
+    }
+}
+
+fn filetime_to_iso(ft: u64) -> String {
+    const SECS_1601_TO_1970: i64 = 11_644_473_600;
+    let secs = (ft / 10_000_000) as i64 - SECS_1601_TO_1970;
+    let days = secs.div_euclid(86_400);
+    let rem = secs.rem_euclid(86_400);
+    // Howard Hinnant, civil_from_days (proleptic Gregorian).
+    let z = days + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let year = y + i64::from(m <= 2);
+    format!(
+        "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z",
+        year,
+        m,
+        d,
+        rem / 3600,
+        (rem % 3600) / 60,
+        rem % 60
+    )
+}
+
+#[cfg(test)]
+mod tests {
