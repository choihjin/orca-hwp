+    pub(super) fn omitted_sections(
+        &self,
+        loaded: &std::collections::HashSet<&str>,
+        header_count: usize,
+    ) -> Option<(usize, usize)> {
+        let expected = self
+            .declared_section_files
+            .len()
+            .max(self.spine_section_count)
+            .max(header_count);
+        let loaded_count = self
+            .declared_section_files
+            .iter()
+            .filter(|p| loaded.contains(p.as_str()))
+            .count();
+        let missing = expected.saturating_sub(loaded_count);
+        if missing == 0 {
+            return None;
+        }
+        let first = self
+            .declared_section_files
+            .iter()
+            .position(|p| !loaded.contains(p.as_str()))
+            .into_iter()
+            .chain(self.first_unresolved)
+            .min()
+            .unwrap_or(loaded_count);
+        Some((first, missing))
+    }
+}
+// Some producers put auxiliary XML in the spine, even with "section" in the
+// name. Only a numbered section token or a dedicated media type identifies a
+// section without reading its root. Explicitly non-XML media remain attachments.
+fn section_item(
+    id: &str,
+    href: &str,
+    media: &str,
+    spine: Option<bool>,
+    probe: impl FnOnce() -> Option<bool>,
+) -> bool {
+    if media == "application/section+xml"
+        || media.ends_with(".section+xml")
+        || media.ends_with("hwpml-section+xml")
+    {
+        return true;
+    }
+    if media != "application/xml" && media != "text/xml" {
+        return false;
+    }
+    let id = id.to_ascii_lowercase();
+    let basename = href.rsplit('/').next().unwrap_or(href).to_ascii_lowercase();
+    let stem = basename.strip_suffix(".xml").unwrap_or(&basename);
+    let tokens = || id.split(['-', '_']).chain(stem.split(['-', '_']));
+    if tokens().any(|t| {
+        t.strip_prefix("section")
+            .is_some_and(|n| !n.is_empty() && n.bytes().all(|b| b.is_ascii_digit()))
+    }) {
+        return true;
+    }
+    if spine.is_none() && !tokens().any(|t| t == "section") {
+        return false;
+    }
+    probe().unwrap_or(spine == Some(true))
+}
