+                }),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+    }
+    fn caption(n: u32) -> Caption {
+        Caption {
+            paragraphs: vec![memo(n)],
+            ..Default::default()
+        }
+    }
+    #[test]
+    fn walks_all_paragraph_owners_in_document_order() {
+        let mut nested = memo(2);
+        nested.controls.push(Control::Footnote(Box::new(Footnote {
+            paragraphs: vec![memo(3)],
+            ..Default::default()
+        })));
+        let mut p = memo(1);
+        p.controls.extend([
+            Control::Table(Box::new(Table {
+                cells: vec![
+                    Cell {
+                        paragraphs: vec![nested],
+                        ..Default::default()
+                    },
+                    Cell {
+                        paragraphs: vec![memo(4)],
+                        ..Default::default()
+                    },
+                ],
+                caption: Some(caption(5)),
+                ..Default::default()
+            })),
+            Control::Shape(Box::new(textbox(6))),
+            Control::Shape(Box::new(ShapeObject::Group(GroupShape {
+                children: vec![textbox(7)],
+                ..Default::default()
+            }))),
+            Control::Picture(Box::new(Picture {
+                caption: Some(caption(8)),
+                ..Default::default()
+            })),
+            Control::Header(Box::new(Header {
+                paragraphs: vec![memo(9)],
+                ..Default::default()
+            })),
+            Control::Footer(Box::new(Footer {
+                paragraphs: vec![memo(10)],
+                ..Default::default()
+            })),
+            Control::Footnote(Box::new(Footnote {
+                paragraphs: vec![memo(11)],
+                ..Default::default()
+            })),
+            Control::Endnote(Box::new(Endnote {
+                paragraphs: vec![memo(12)],
+                ..Default::default()
+            })),
+        ]);
+        let mut s = Section {
+            paragraphs: vec![p],
+            ..Default::default()
+        };
+        s.section_def.master_pages.push(MasterPage {
+            paragraphs: vec![memo(13)],
+            ..Default::default()
+        });
+        let report = read(s);
+        let memos = report["memos"].as_array().unwrap();
+        let places = [
+            "body",
+            "tableCell",
+            "footnote",
+            "tableCell",
+            "caption",
+            "textBox",
+            "textBox",
+            "caption",
+            "header",
+            "footer",
+            "footnote",
+            "endnote",
+            "masterPage",
+        ];
+        assert_eq!(memos.len(), places.len());
+        for (i, (m, place)) in memos.iter().zip(places).enumerate() {
+            assert_eq!(m["number"], i + 1);
+            assert_eq!(m["place"], place);
+            assert_eq!(m["anchorText"], "예산");
+            assert_eq!(m["author"], "재무 담당");
+            assert_eq!(m["date"], "2026-11-20T08:24:04Z");
+        }
+        assert_eq!(memos[1]["path"][0]["cellIndex"], 0);
+        assert_eq!(memos[3]["path"][0]["cellIndex"], 1);
+        assert!(memos[2]["path"].is_null());
+        assert!(memos[12]["ownerParaIndex"].is_null());
+        assert_eq!(report["problems"], serde_json::json!([]));
+    }
+    #[test]
+    fn multi_paragraph_empty_range_and_missing_bodies() {
+        let mut a = memo(1);
+        a.field_ranges.clear();
+        let Control::Field(f) = &mut a.controls[0] else {
+            unreachable!()
+        };
+        f.memo_paragraphs.clear();
+        let mut b = memo(2);
+        b.field_ranges[0].end_char_idx = 1;
+        let report = read(Section {
+            paragraphs: vec![a, b],
+            memo_bodies: vec![MemoBody {
+                number: 8,
+                paragraphs: vec![Paragraph {
+                    text: "lost".into(),
+                    ..Default::default()
+                }],
+            }],
+            memo_problems: vec![MemoProblem::SectionUnreadable],
+            ..Default::default()
+        });
+        let m = &report["memos"];
+        assert_eq!(m[0]["multiParagraph"], true);
+        assert!(m[0]["endCharIdx"].is_null());
+        assert!(m[0]["text"].is_null());
+        assert_eq!(m[1]["multiParagraph"], false);
+        assert_eq!(m[1]["startCharIdx"], m[1]["endCharIdx"]);
+        assert_eq!(m[1]["text"], "");
+        assert_eq!(m[2]["place"], "unlinked");
+        assert_eq!(m[2]["text"], "lost");
+        let problems = report["problems"].as_array().unwrap();
+        for p in [
+            serde_json::json!({"code":"section-unreadable","sectionIndex":0}),
+            serde_json::json!({"code":"unlinked-body","number":8}),
+            serde_json::json!({"code":"no-body","number":1}),
+        ] {
+            assert!(problems.contains(&p));
+        }
+    }
+}
