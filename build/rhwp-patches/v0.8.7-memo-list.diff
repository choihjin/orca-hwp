+pub(crate) const MEMO_MAX_DEPTH: usize = 8; // Same as injection_scan::MAX_DEPTH.
+
+/// Read across sections in field order. Queues also preserve the order of duplicate numbers.
+pub fn attach_memo_bodies(sections: &mut [Section]) {
+    use crate::model::shape::ShapeObject;
+    use std::collections::{HashMap, VecDeque};
+    if sections.iter().all(|s| s.memo_bodies.is_empty()) {
+        return;
+    }
+    type Bodies = HashMap<u32, VecDeque<(usize, usize, MemoBody)>>;
+    fn shape(s: &mut ShapeObject, depth: usize, bodies: &mut Bodies) {
+        if depth > MEMO_MAX_DEPTH {
+            return;
+        }
+        if let Some(tb) = s.drawing_mut().and_then(|d| d.text_box.as_mut()) {
+            walk(&mut tb.paragraphs, depth + 1, bodies);
+        }
+        if let Some(c) = crate::document_core::helpers::get_caption_from_shape_mut(s) {
+            walk(&mut c.paragraphs, depth + 1, bodies);
+        }
+        if let ShapeObject::Group(g) = s {
+            for child in &mut g.children {
+                shape(child, depth + 1, bodies);
+            }
+        }
+    }
+    fn walk(ps: &mut [Paragraph], depth: usize, bodies: &mut Bodies) {
+        if depth > MEMO_MAX_DEPTH {
+            return;
+        }
+        for p in ps {
+            for ctrl in &mut p.controls {
+                match ctrl {
+                    Control::Field(f) if f.memo_paragraphs.is_empty() => {
+                        if let Some((_, _, b)) = memo_number(f)
+                            .and_then(|n| bodies.get_mut(&n))
+                            .and_then(VecDeque::pop_front)
+                        {
+                            f.memo_paragraphs = b.paragraphs;
+                        }
+                    }
+                    Control::Table(t) => {
+                        for c in &mut t.cells {
+                            walk(&mut c.paragraphs, depth + 1, bodies);
+                        }
+                        if let Some(c) = &mut t.caption {
+                            walk(&mut c.paragraphs, depth + 1, bodies);
+                        }
+                    }
+                    Control::Shape(s) => shape(s, depth, bodies),
+                    Control::Picture(p) => {
+                        if let Some(c) = &mut p.caption {
+                            walk(&mut c.paragraphs, depth + 1, bodies);
+                        }
+                    }
+                    Control::Header(h) => walk(&mut h.paragraphs, depth + 1, bodies),
+                    Control::Footer(h) => walk(&mut h.paragraphs, depth + 1, bodies),
+                    Control::Footnote(n) => walk(&mut n.paragraphs, depth + 1, bodies),
+                    Control::Endnote(n) => walk(&mut n.paragraphs, depth + 1, bodies),
+                    _ => {}
+                }
+            }
+        }
+    }
+    let mut bodies = Bodies::new();
+    for (si, s) in sections.iter_mut().enumerate() {
+        for (i, b) in s.memo_bodies.drain(..).enumerate() {
+            bodies.entry(b.number).or_default().push_back((si, i, b));
+        }
+    }
+    for s in sections.iter_mut() {
+        walk(&mut s.paragraphs, 0, &mut bodies);
+        for m in &mut s.section_def.master_pages {
+            walk(&mut m.paragraphs, 0, &mut bodies);
+        }
+    }
+    let mut remaining: Vec<_> = bodies.into_values().flatten().collect();
+    remaining.sort_by_key(|(si, i, _)| (*si, *i));
+    for (si, _, b) in remaining {
+        sections[si].memo_bodies.push(b);
+    }
+}
