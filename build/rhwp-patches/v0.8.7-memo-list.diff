+use crate::document_core::DocumentCore;
+use crate::model::{
+    control::{Control, Field, Parameter},
+    document::MemoProblem,
+    paragraph::Paragraph,
+    shape::ShapeObject,
+};
+use crate::parser::body_text::{memo_number, MEMO_MAX_DEPTH};
+use serde::Serialize;
+use serde_json::{json, Value};
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CellPath {
+    control_index: usize,
+    cell_index: usize,
+    cell_para_index: usize,
+}
+
+struct Reader {
+    output: Output,
+    found: usize,
+    section: usize,
+    owner: Option<usize>,
+    path: Vec<CellPath>,
+    paragraph_serial: usize,
+}
+
+const MAX_JSON_BYTES: usize = 8 * 1024 * 1024;
+const EXCERPT_CHARS: usize = 2000;
+
+#[derive(Serialize, Default)]
+#[serde(rename_all = "camelCase")]
+struct Entry<'a> {
+    number: u32,
+    place: &'a str,
+    author: &'a str,
+    text: Option<&'a str>,
+    date: Option<String>,
+    date_text: Option<&'a str>,
+    paragraph_text: &'a str,
+    anchor_text: &'a str,
+    anchor_key: String,
+    multi_paragraph: bool,
+    section_index: Option<usize>,
+    owner_para_index: Option<usize>,
+    para_index: Option<usize>,
+    path: Option<&'a [CellPath]>,
+    start_char_idx: Option<usize>,
+    end_char_idx: Option<usize>,
+}
+
+struct Output {
+    entries: Vec<u8>,
+    problems: Vec<u8>,
+    limit: usize,
+    missing: usize,
+    stopped: bool,
+    omitted_problems: bool,
+}
+
+// Serialize directly into the response buffers. Checking each write also bounds
+// strings that expand under JSON escaping without allocating an oversized entry.
+struct Limited<'a> {
+    bytes: &'a mut Vec<u8>,
+    room: usize,
+}
+impl std::io::Write for Limited<'_> {
+    fn write(&mut self, b: &[u8]) -> std::io::Result<usize> {
+        if b.len() > self.room {
+            return Err(std::io::ErrorKind::WriteZero.into());
+        }
+        self.bytes.extend_from_slice(b);
+        self.room -= b.len();
+        Ok(b.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+fn append_member(buffer: &mut Vec<u8>, room: usize, value: &impl Serialize) -> bool {
+    use std::io::Write;
+    let before = buffer.len();
+    let mut writer = Limited {
+        bytes: buffer,
+        room,
+    };
+    if (before == 0 || writer.write_all(b",").is_ok())
+        && serde_json::to_writer(&mut writer, value).is_ok()
+    {
+        return true;
+    }
+    buffer.truncate(before);
+    false
+}
+impl Output {
+    fn room(&self) -> usize {
+        // Includes the envelope, separators, the largest missing count, and a
+        // bad-record marker if even the parser diagnostics exhaust the budget.
+        self.limit
+            .saturating_sub(128 + self.entries.len() + self.problems.len())
+    }
+    fn problem(&mut self, p: &Value) {
+        let room = self.room();
+        if !append_member(&mut self.problems, room, p) {
+            self.omitted_problems = true;
+            self.stopped = true;
+        }
+    }
+    fn skip(&mut self) {
+        self.stopped = true;
+        self.missing += 1;
+    }
+    fn entry(&mut self, e: &Entry<'_>, problem: Option<Value>) {
+        let before = self.entries.len();
+        let room = self.room();
+        if !append_member(&mut self.entries, room, e) {
+            self.skip();
+            return;
+        }
+        if let Some(p) = problem {
+            let room = self.room();
+            if !append_member(&mut self.problems, room, &p) {
+                self.entries.truncate(before);
+                self.skip();
+            }
+        }
+    }
+    fn finish(mut self) -> String {
+        if self.omitted_problems {
+            append_member(&mut self.problems, 128, &json!({"code":"bad-record"}));
+        }
+        if self.missing != 0 {
+            append_member(
+                &mut self.problems,
+                128,
+                &json!({"code":"missing-memo","count":self.missing}),
+            );
+        }
+        let mut result = Vec::with_capacity(self.entries.len() + self.problems.len() + 28);
+        for part in [
+            b"{\"memos\":[".as_slice(),
+            &self.entries,
+            b"],\"problems\":[",
+            &self.problems,
+            b"]}",
+        ] {
+            result.extend_from_slice(part);
+        }
+        String::from_utf8(result).expect("serialized JSON is UTF-8")
+    }
+}
+
+fn body_text(ps: &[Paragraph], room: usize) -> Result<Option<std::borrow::Cow<'_, str>>, ()> {
+    use std::borrow::Cow;
+    let Some((first, rest)) = ps.split_first() else {
+        return Ok(None);
+    };
+    let size = rest.iter().fold(first.text.len(), |n, p| {
+        n.saturating_add(p.text.len()).saturating_add(1)
+    });
+    if size > room {
+        return Err(());
+    }
+    if rest.is_empty() {
+        return Ok(Some(Cow::Borrowed(&first.text)));
+    }
+    let mut text = String::with_capacity(size);
+    text.push_str(&first.text);
+    for p in rest {
+        text.push('\n');
+        text.push_str(&p.text);
+    }
+    Ok(Some(Cow::Owned(text)))
+}
+
+struct Anchors<'a> {
+    chars: Vec<char>,
+    excerpt: String,
+    ranges: Vec<Option<&'a crate::model::paragraph::FieldRange>>,
+    positions: Option<Vec<usize>>,
+}
+impl<'a> Anchors<'a> {
+    fn new(p: &'a Paragraph) -> Self {
+        let chars: Vec<_> = p.text.chars().collect();
+        let excerpt = chars.iter().take(EXCERPT_CHARS).collect();
+        let mut ranges = vec![None; p.controls.len()];
+        for r in &p.field_ranges {
+            if let Some(slot) = ranges.get_mut(r.control_idx) {
+                slot.get_or_insert(r);
+            }
+        }
+        Self {
+            chars,
+            excerpt,
+            ranges,
+            positions: None,
+        }
+    }
+}
+
+// The innermost cell or text box can be located only under an addressable owner.
+fn nested_place(outer: &'static str, inner: &'static str) -> &'static str {
+    match outer {
+        "body" | "tableCell" | "textBox" => inner,
+        _ => outer,
+    }
+}
+fn param<'a>(field: &'a Field, key: &str) -> Option<&'a str> {
+    field.parameters.items.iter().find_map(|p| match p {
+        Parameter::String {
+            name: Some(name),
+            value,
+            ..
+        } if name == key => Some(value.as_str()),
+        _ => None,
+    })
+}
+
+fn command_date(command: &str) -> Option<String> {
+    let mut tokens = command.strip_prefix("MEMO/")?.split('/').skip(2);
+    let low = tokens.next()?.parse::<u32>().ok()?;
+    let high = tokens.next()?.parse::<u32>().ok()?;
+    let ticks = u64::from(high) << 32 | u64::from(low);
+    if ticks == 0 {
+        return None;
+    }
+    filetime_to_iso(ticks)
+}
+
+impl Reader {
+    fn nested(
+        &mut self,
+        paragraphs: &[Paragraph],
+        place: &'static str,
+        depth: usize,
+        cell: Option<(usize, usize)>,
+        markable: bool,
+    ) {
+        if paragraphs.is_empty() || depth > MEMO_MAX_DEPTH {
+            return;
+        }
+        for (pi, p) in paragraphs.iter().enumerate() {
+            if let Some((control_index, cell_index)) = cell {
+                self.path.push(CellPath {
+                    control_index,
+                    cell_index,
+                    cell_para_index: pi,
+                });
+            }
+            self.paragraph(p, pi, place, depth, markable);
+            if cell.is_some() {
+                self.path.pop();
+            }
+        }
+    }
+    fn shape(
+        &mut self,
+        s: &ShapeObject,
+        ci: usize,
+        place: &'static str,
+        depth: usize,
+        markable: bool,
+    ) {
+        if depth > MEMO_MAX_DEPTH {
+            return;
+        }
+        if let Some(tb) = s.drawing().and_then(|d| d.text_box.as_ref()) {
+            self.nested(
+                &tb.paragraphs,
+                nested_place(place, "textBox"),
+                depth + 1,
+                Some((ci, 0)),
+                markable,
+            );
+        }
+        if let Some(c) = crate::document_core::helpers::get_caption_from_shape(s) {
+            self.nested(&c.paragraphs, "caption", depth + 1, None, false);
+        }
+        if let ShapeObject::Group(g) = s {
+            // Cell paths have no group-child component.
+            for child in &g.children {
+                self.shape(child, ci, place, depth + 1, false);
+            }
+        }
+    }
+    fn paragraph(
+        &mut self,
+        p: &Paragraph,
+        pi: usize,
+        place: &'static str,
+        depth: usize,
+        markable: bool,
+    ) {
+        self.paragraph_serial += 1;
+        let serial = self.paragraph_serial;
+        let mut anchors = None;
+        for (ci, ctrl) in p.controls.iter().enumerate() {
+            match ctrl {
+                Control::Field(f) => {
+                    let Some(number) = memo_number(f) else {
+                        continue;
+                    };
+                    self.found += 1;
+                    if self.output.stopped {
+                        self.output.skip();
+                        continue;
+                    }
+                    let Ok(body) = body_text(&f.memo_paragraphs, self.output.room()) else {
+                        self.output.skip();
+                        continue;
+                    };
+                    let a = anchors.get_or_insert_with(|| Anchors::new(p));
+                    let range = a.ranges[ci];
+                    let start = range.map(|r| r.start_char_idx).unwrap_or_else(|| {
+                        a.positions
+                            .get_or_insert_with(|| p.control_text_positions())
+                            .get(ci)
+                            .copied()
+                            .unwrap_or_default()
+                    });
+                    let end = range.map(|r| r.end_char_idx);
+                    let key = match range {
+                        Some(r) if end == Some(start) => format!(
+                            "{serial}/{start}/{start}/{}",
+                            ci.saturating_add(r.inner_slot_count)
+                        ),
+                        Some(r) => format!("{serial}/{start}/{}", r.end_char_idx),
+                        None => format!("{serial}/open/{ci}"),
+                    };
+                    let from = start.min(a.chars.len());
+                    let to = end
+                        .unwrap_or(a.chars.len())
+                        .clamp(from, a.chars.len())
+                        .min(from.saturating_add(EXCERPT_CHARS));
+                    let anchor: String = a.chars[from..to].iter().collect();
+                    let date = command_date(&f.command);
+                    let date_text = if date.is_none() {
+                        param(f, "CreateDateTime")
+                    } else {
+                        None
+                    };
+                    let author =
+                        param(f, "Author")
+                            .filter(|a| !a.is_empty())
+                            .unwrap_or_else(|| {
+                                let tail = f.command.splitn(6, '/').nth(5).unwrap_or("");
+                                tail.rsplit_once('/').map_or(tail, |(author, _)| author)
+                            });
+                    let entry = Entry {
+                        number,
+                        place,
+                        text: body.as_deref(),
+                        author,
+                        date,
+                        date_text,
+                        anchor_text: &anchor,
+                        paragraph_text: &a.excerpt,
+                        anchor_key: key,
+                        multi_paragraph: end.is_none(),
+                        section_index: Some(self.section),
+                        owner_para_index: self.owner,
+                        para_index: markable.then_some(pi),
+                        path: markable.then_some(&self.path),
+                        start_char_idx: markable.then_some(start),
+                        end_char_idx: end.filter(|_| markable),
+                    };
+                    self.output.entry(
+                        &entry,
+                        body.is_none()
+                            .then(|| json!({"code":"no-body","number":number})),
+                    );
+                }
+                Control::Table(t) => {
+                    for (i, c) in t.cells.iter().enumerate() {
+                        self.nested(
+                            &c.paragraphs,
+                            nested_place(place, "tableCell"),
+                            depth + 1,
+                            Some((ci, i)),
+                            markable,
+                        );
+                    }
+                    if let Some(c) = &t.caption {
+                        self.nested(&c.paragraphs, "caption", depth + 1, None, false);
+                    }
+                }
+                Control::Shape(s) => self.shape(s, ci, place, depth, markable),
+                Control::Picture(pic) => {
+                    if let Some(c) = &pic.caption {
+                        self.nested(&c.paragraphs, "caption", depth + 1, None, false);
+                    }
+                }
+                Control::Header(h) => self.nested(&h.paragraphs, "header", depth + 1, None, false),
+                Control::Footer(h) => self.nested(&h.paragraphs, "footer", depth + 1, None, false),
+                Control::Footnote(n) => {
+                    self.nested(&n.paragraphs, "footnote", depth + 1, None, false)
+                }
+                Control::Endnote(n) => {
+                    self.nested(&n.paragraphs, "endnote", depth + 1, None, false)
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+impl DocumentCore {
+    pub fn get_memos_json(&self) -> String {
+        self.memos_json_with_limit(MAX_JSON_BYTES)
+    }
+    fn memos_json_with_limit(&self, limit: usize) -> String {
+        let mut reader = Reader {
+            output: Output {
+                entries: vec![],
+                problems: vec![],
+                limit,
+                missing: 0,
+                stopped: false,
+                omitted_problems: false,
+            },
+            found: 0,
+            section: 0,
+            owner: None,
+            path: vec![],
+            paragraph_serial: 0,
+        };
+        for (si, s) in self.document.sections.iter().enumerate() {
+            reader.section = si;
+            for problem in &s.memo_problems {
+                reader.output.problem(&match problem {
+                    MemoProblem::BadRecord => json!({"code":"bad-record"}),
+                    MemoProblem::SectionUnreadable => {
+                        json!({"code":"section-unreadable","sectionIndex":si})
+                    }
+                });
+            }
+            reader.found = 0;
+            for (pi, p) in s.paragraphs.iter().enumerate() {
+                reader.owner = Some(pi);
+                reader.paragraph(p, pi, "body", 0, true);
+            }
+            reader.owner = None;
+            for mp in &s.section_def.master_pages {
+                reader.nested(&mp.paragraphs, "masterPage", 0, None, false);
+            }
+            reader.output.missing += s.declared_memo_count.saturating_sub(reader.found);
+        }
+        for (si, s) in self.document.sections.iter().enumerate() {
+            for (i, b) in s.memo_bodies.iter().enumerate() {
+                if reader.output.stopped {
+                    reader.output.skip();
+                    continue;
+                }
+                let Ok(body) = body_text(&b.paragraphs, reader.output.room()) else {
+                    reader.output.skip();
+                    continue;
+                };
+                let entry = Entry {
+                    place: "unlinked",
+                    number: b.number,
+                    text: body.as_deref(),
+                    anchor_key: format!("unlinked/{si}/{i}"),
+                    ..Default::default()
+                };
+                reader.output.entry(
+                    &entry,
+                    Some(json!({"code":"unlinked-body","number":b.number})),
+                );
+            }
+        }
+        reader.output.finish()
+    }
+}
+
+fn filetime_to_iso(ft: u64) -> Option<String> {
+    const SECS_1601_TO_1970: i64 = 11_644_473_600;
+    let secs = (ft / 10_000_000) as i64 - SECS_1601_TO_1970;
+    let days = secs.div_euclid(86_400);
+    let rem = secs.rem_euclid(86_400);
+    // Howard Hinnant, civil_from_days (proleptic Gregorian).
+    let z = days + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let year = y + i64::from(m <= 2);
+    if !(1601..=9999).contains(&year) {
+        return None;
+    }
+    Some(format!(
+        "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z",
+        year,
+        m,
+        d,
+        rem / 3600,
+        (rem % 3600) / 60,
+        rem % 60
+    ))
+}
