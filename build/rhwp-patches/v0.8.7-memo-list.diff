+fn split_memo_tail(mut records: Vec<Record>) -> (Vec<Record>, Vec<MemoBody>, Vec<MemoProblem>) {
+    let is_memo = |r: &Record| r.level == 1 && r.tag_id == tags::HWPTAG_MEMO_LIST;
+    let after_body = records
+        .iter()
+        .rposition(|r| r.level == 0 && r.tag_id == tags::HWPTAG_PARA_HEADER)
+        .map_or(0, |i| i + 1);
+    let Some(offset) = records[after_body..].iter().position(is_memo) else {
+        return (records, vec![], vec![]);
+    };
+    let mut tail = records
+        .split_off(after_body + offset)
+        .into_iter()
+        .peekable();
+    let mut bodies = Vec::new();
+    let mut problems = Vec::new();
+    while let Some(head) = tail.next() {
+        if !is_memo(&head) {
+            records.push(head);
+            continue;
+        }
+        if !tail
+            .peek()
+            .is_some_and(|r| r.level == 1 && r.tag_id == tags::HWPTAG_LIST_HEADER)
+        {
+            problems.push(MemoProblem::BadRecord);
+            continue;
+        }
+        let header = tail.next().unwrap();
+        let mut children = Vec::new();
+        while tail.peek().is_some_and(|r| {
+            !(r.level == 1 && matches!(r.tag_id, tags::HWPTAG_LIST_HEADER | tags::HWPTAG_MEMO_LIST))
+        }) {
+            let child = tail.next().unwrap();
+            if child.tag_id == tags::HWPTAG_MEMO_LIST {
+                problems.push(MemoProblem::BadRecord);
+            }
+            children.push(child);
+        }
+        let (Some(number), Some(count)) =
+            (head.data.first_chunk::<4>(), header.data.first_chunk::<2>())
+        else {
+            problems.push(MemoProblem::BadRecord);
+            continue;
+        };
+        let mut paragraphs = Vec::new();
+        let mut rest = children.as_slice();
+        while let Some(first) = rest.first() {
+            if first.tag_id != tags::HWPTAG_PARA_HEADER || first.data.len() < 22 {
+                problems.push(MemoProblem::BadRecord);
+                break;
+            }
+            let end = rest[1..]
+                .iter()
+                .position(|r| r.level <= first.level)
+                .map_or(rest.len(), |i| i + 1);
+            match parse_paragraph(&rest[..end]) {
+                Ok(p) => paragraphs.push(p),
+                Err(_) => problems.push(MemoProblem::BadRecord),
+            }
+            rest = &rest[end..];
+        }
+        if paragraphs.is_empty() || paragraphs.len() != u16::from_le_bytes(*count) as usize {
+            problems.push(MemoProblem::BadRecord);
+        }
+        if !paragraphs.is_empty() {
+            link_orphan_field_ends(&mut paragraphs);
+            bodies.push(MemoBody {
+                number: u32::from_le_bytes(*number),
+                paragraphs,
+            });
+        }
+    }
+    (records, bodies, problems)
+}
