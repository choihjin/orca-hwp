+pub(crate) fn memo_number(field: &crate::model::control::Field) -> Option<u32> {
+    use crate::model::control::FieldType;
+    if field.field_type != FieldType::Memo && !field.command.starts_with("MEMO/") {
+        return None;
+    }
+    Some(if field.memo_index != 0 {
+        field.memo_index
+    } else {
+        field
+            .command
+            .split('/')
+            .nth(2)
+            .and_then(|n| n.parse().ok())
+            .unwrap_or(0)
+    })
+}
