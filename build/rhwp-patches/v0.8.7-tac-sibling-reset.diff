 ///
 /// 정확히 절반인 문단까지 낱장 정책을 적용하면 기존 pile 문서의 다수 그림 흐름을
 /// 불필요하게 페이지 단위로 분리한다. 두 장 이상이라는 #1995의 하한은 유지한다.
+/// 원본 저장 줄 사다리에서 글자 취급 컨트롤이 놓인 줄과, 같은 줄을 앞 글자 취급
+/// 컨트롤이 이미 차지했는지.
+///
+/// 한 문단에 글자 취급 표·도형 여럿이 줄마다 놓이면 줄 수와 컨트롤 수가 같지 않을 수
+/// 있다(한 줄에 도형 둘, 표와 도형 하나씩). 앞 컨트롤 수로 줄을 세면 다른 컨트롤의
+/// 줄 높이·쪽 리셋(vpos 0)을 이 컨트롤의 것으로 읽는다. 제어 슬롯 위치와 저장 줄의
+/// `text_start` 로 소속을 정한다([`crate::renderer::layout::control_line_seg_index`]).
+/// TAC 높이 상한(`tac_reconcile::measure`)이 같은 조건(원본 HWP5 저장 조판, 편집 전)에서
+/// 같은 해석기로 표 줄을 세므로, 흐름 전진과 쪽 리셋 판정도 그 줄을 따른다.
+/// 편집으로 줄 분할이 바뀌었거나 합성 줄이 있으면 쓰지 않는다.
+pub(crate) fn stored_inline_control_line(
+    para: &Paragraph,
+    ctrl_idx: usize,
+    profile: crate::model::provenance::LayoutCompatibilityProfile,
+) -> Option<(usize, bool)> {
+    if !profile.hwp5_stored_pagination_layout()
+        || profile.session_edited()
+        || para.stored_text_partition_is_dirty()
+        || para.cell_format_vpos_dirty
+        || para.line_segs.len() < 2
+        || para
+            .line_segs
+            .iter()
+            .any(|seg| seg.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+    {
+        return None;
+    }
+    let inline = |control: &Control| match control {
+        Control::Table(table) => table.common.treat_as_char,
+        Control::Picture(picture) => picture.common.treat_as_char,
+        Control::Shape(shape) => shape.common().treat_as_char,
+        Control::Equation(equation) => equation.common.treat_as_char,
+        _ => false,
+    };
+    if !inline(para.controls.get(ctrl_idx)?) {
+        return None;
+    }
+    let line = crate::renderer::layout::control_line_seg_index(para, ctrl_idx)?;
+    if line >= para.line_segs.len() {
+        return None;
+    }
+    let shared_with_earlier =
+        para.controls[..ctrl_idx]
+            .iter()
+            .enumerate()
+            .any(|(index, control)| {
+                inline(control)
+                    && crate::renderer::layout::control_line_seg_index(para, index) == Some(line)
+            });
+    Some((line, shared_with_earlier))
+}
