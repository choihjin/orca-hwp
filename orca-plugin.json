{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "hwp-viewer",
  "name": "HWP Viewer",
  "version": "0.1.0",
  "description": "Read-only viewer for Hangul word processor documents (.hwp and .hwpx) inside Orca, drawn page by page with the rhwp engine. An independent project, not affiliated with Hancom.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "capabilities": [],
  "contributes": {
    "customEditors": [
      {
        "id": "hwp-viewer",
        "title": "HWP Viewer",
        "extensions": [
          ".hwpx",
          ".hwp"
        ],
        "entry": "editor/index.html",
        "frame": "isolated",
        "priority": "default",
        "contentKind": "bytes"
      }
    ]
  },
  "license": "MIT"
}
